# Copy to .env.local (dev) or console.env (docker compose). FAKE values only - never commit real ones.

# Repo root that holds cache/ and reports/ (inside the container: /data)
BOTTREAD_ROOT=/data

# One shared login password and the key that signs the session cookie (>= 16 chars, random)
CONSOLE_PASSWORD=change-me-fake-password
CONSOLE_SECRET=0123456789abcdef0123456789abcdef-fake

PORT=3300

# Timezone of the timestamps in cache/team.log, minutes east of UTC (Python logs server-local time: UTC=0, Bangkok=420)
LOG_TZ_OFFSET_MIN=420

# Set to 1 only when a single reverse proxy sits in front: lockout then counts per client IP (X-Forwarded-For)
TRUST_PROXY=0

# Set to 1 to force the Secure flag on the cookie (HTTPS is detected from X-Forwarded-Proto anyway)
COOKIE_SECURE=0
