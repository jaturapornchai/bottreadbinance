# --- Auto Short (Binance USDⓈ-M futures) : README หัวข้อ Auto Short ---
# Binance key / ไม้ละกี่ USDT / เทรดจริง-ทดสอบ อยู่บน server เท่านั้น (ตั้งด้วย bottread-dca-setup ใน Console ของ server)
# เครื่องนี้แค่ส่งแผนผ่าน SSH tunnel; เว้น DCA_PROXY_HOST ว่าง = ปิด Auto Short
DCA_PROXY_HOST=203.0.113.10
DCA_PROXY_USER=dcaproxy
DCA_PROXY_KEY=~/.ssh/bottread_proxy_ed25519
# รหัสผ่านระหว่างเครื่องนี้กับ server (ยาว 32+ ตัว) — ตอนติดตั้งสร้างให้เองและใส่ทั้งสองฝั่ง ห้ามแชร์
DCA_PLAN_TOKEN=

# --- Remote Trading Server (PC Scheduler & deploy.sh) ---
BOTTREAD_SSH_TARGET=user@192.0.2.10
BOTTREAD_SSH_ALIAS=
BOTTREAD_HOST=user@192.0.2.10
